# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.env*.local

# Claude Code local harness data (sessions, worktrees, etc.)
.claude/

# ...except the RIM design system skill, which is versioned alongside the
# stylesheet it documents. A design system that isn't tracked next to its
# source drifts silently — git has to be able to show the diff.
# Its assets/ are symlinks into public/, so there is one copy of each binary.
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/rim-design/
# ...and the two ritual skills CLAUDE.md dispatches to by name. CLAUDE.md is
# tracked, so if these aren't, every other checkout (worktrees included) has a
# directive pointing at a skill that isn't there.
!.claude/skills/closing-ritual/
!.claude/skills/backlog/
