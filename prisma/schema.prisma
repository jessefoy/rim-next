// RIM Member Management Database Schema
// Prisma + Vercel Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── AUTH (required by NextAuth/Auth.js) ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── MEMBER PROFILE ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  firstName     String?
  lastName      String?
  phone         String?
  roles         Role[]    @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Community membership threshold
  agreedToTerms Boolean   @default(false)
  agreedAt      DateTime?

  // Soft-delete: archived members cannot log in but their records are preserved
  archivedAt    DateTime?

  // Extended profile fields
  preferredName   String?
  title           String?     // Display title: "Guiding Teacher", "Program Registrar", etc.
  addressLine1    String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  memberStatus    MemberStatus @default(ACTIVE)
  firstVisitDate  DateTime?
  adminNotes      Json?             // BlockNote JSON (RimProseEditor)
  tags            String[]     @default([])
  // Viewer-level section access grants — sections this person can view on other member profiles
  // without holding the team role. Admin-assigned. Example values: "admin-notes", "care-notes"
  sectionGrants   String[]     @default([])

  // Learning system
  lessonProgress      LessonProgress[]
  seriesEnrollments   SeriesEnrollment[]
  lessonNotes         LessonNote[]
  reflectionResponses ReflectionResponse[]
  isTeacher           Boolean        @default(false)
  teacherProfile      TeacherProfile?
  lessonTeachers      LessonTeacher[]
  programTeachers     ProgramTeacher[]

  // Support inbox notification preference
  supportEmailNotifications Boolean @default(true)

  // Legacy data imported from Memberstack (kept for historical reference)
  legacyMemberstackId     String?   @unique
  legacyLastLogin         DateTime?
  legacyLastAttendance    DateTime?
  legacyActivityCount     Int?
  legacyMemberSince       DateTime?

  // Relations
  accounts        Account[]
  sessions        Session[]
  memberships     UserMembership[]
  attendance      AttendanceRecord[]
  registrations   Registration[]
  courseAccess    CourseAccess[]
  household       HouseholdMember?
  hostAssignments HostAssignment[]   @relation("HostAssignments")
  subClaims       SubClaim[]         @relation("SubClaims")
  alerts          Alert[]            @relation("Alerts")
  // Session attendance
  sessionAttendances SessionAttendance[]
  sessionReports     SessionReport[]
  // Hub system
  hubMemberships  HubMember[]
  hubDocuments       HubDocument[] @relation("HubDocumentAuthor")
  hubDocumentsEditing HubDocument[] @relation("HubDocumentEditor")
  hubThreads2     HubConversationThread[]
  hubReplies2     HubConversationReply[]
  emailTemplates  EmailTemplate[]
  // Support inbox
  assignedThreads    SupportThread[]   @relation("ThreadAssignee")
  memberThreads      SupportThread[]   @relation("ThreadMember")
  sentMessages       SupportMessage[]  @relation("MessageSender")
  supportNotes       SupportNote[]     @relation("NoteAuthor")
  supportSignature   SupportSignature?
  supportTemplates   SupportTemplate[] @relation("TemplateCreator")
  // Session co-hosting
  sessionCoHosts       SessionCoHost[]       @relation("SessionCoHosts")
  sessionCoHostReports SessionCoHostReport[] @relation("SessionCoHostReports")
  // Hub access grants
  hubAccess            UserHubAccess[]
  hubAccessGranted     UserHubAccess[]       @relation("HubAccessGranter")
  // Tool access grants (individual access without role)
  toolAccess           UserToolAccess[]      @relation("ToolAccess")
  toolAccessGranted    UserToolAccess[]      @relation("ToolAccessGranter")
  dripNotifications    DripNotification[]
  siteBannersCreated   SiteBanner[]          @relation("SiteBannerCreator")
  siteBannerDismissals SiteBannerDismissal[] @relation("SiteBannerDismissal")
  taskListsCreated     TaskList[]             @relation("TaskListCreatedBy")
  tasksAssigned        Task[]                 @relation("TaskAssignee")
  tasksCreated         Task[]                 @relation("TaskCreatedBy")
  subtasksAssigned     Subtask[]              @relation("SubtaskAssignee")
  subtasksCreated      Subtask[]              @relation("SubtaskCreatedBy")

  @@map("users")
}

enum Role {
  HOST                 // Zoom host rotation — access to host hub; can host sessions + claim subs
  HOST_MANAGER         // manages host schedule and community; full hub read/write
  REGISTRAR            // manages program registrations
  ADMIN                // full access
  TEACHER              // course/lesson management via Course Manager tool
  SUPPORT              // support inbox — reads/replies to support@rootedinmindfulness.org
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
  STUDENT
  VOLUNTEER
}

enum RelationshipType {
  SPOUSE
  PARTNER
  PARENT
  CHILD
  SIBLING
  OTHER
}

// ─── HOUSEHOLDS ──────────────────────────────────────────────────────────────

model Household {
  id           String   @id @default(cuid())
  name         String?  // e.g. "The Smith Family" — optional display name
  addressLine1 String?
  addressCity  String?
  addressState String?
  addressZip   String?
  notes        Json?       // BlockNote JSON (RimProseEditor)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members HouseholdMember[]

  @@map("households")
}

model HouseholdMember {
  id                 String           @id @default(cuid())
  householdId        String
  userId             String           @unique  // one household per member (enforced at DB level)
  relationshipType   RelationshipType @default(OTHER)
  relationshipCustom String?          // only when type = OTHER; logged for future enum promotion
  isPrimary          Boolean          @default(false)
  createdAt          DateTime         @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("household_members")
}

// ─── MEMBERSHIP TYPES ────────────────────────────────────────────────────────

model MembershipType {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. "General Member", "Dharma Study Group"
  slug        String   @unique  // e.g. "general", "dharma-study-group"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  members UserMembership[]

  @@map("membership_types")
}

model UserMembership {
  id               String         @id @default(cuid())
  userId           String
  membershipTypeId String
  joinedAt         DateTime       @default(now())
  isActive         Boolean        @default(true)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id])

  @@unique([userId, membershipTypeId])
  @@map("user_memberships")
}

// ─── ATTENDANCE (Phase 2 — table created now, populated later) ───────────────

model AttendanceRecord {
  id          String           @id @default(cuid())
  userId      String
  recordedAt  DateTime         @default(now())
  eventDate   DateTime
  eventName   String
  eventType   AttendanceType
  format      AttendanceFormat
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

enum AttendanceType {
  CLASS
  RETREAT
  STUDY_GROUP
  VOLUNTEER
  EVENT
}

enum AttendanceFormat {
  IN_PERSON
  ONLINE
}

// ─── PROGRAMS (migrated from Sanity) ──────────────────────────────────────────

model ProgramCategory {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  sortOrder            Int       @default(0)
  hideFromProgramsPage Boolean   @default(false)
  programs             Program[]

  @@map("program_categories")
}

model Program {
  id    String @id @default(cuid())
  slug  String @unique
  name  String

  // ── Content ────────────────────────────────────────────
  tagline             String?
  programImage        String?          // URL (Vercel Blob or external)
  description         Json?            // BlockNote JSON (RimBlockEditor)
  pullQuote           String?
  pullQuoteSource     String?
  specialNotes        Json?            // BlockNote JSON (RimProseEditor)
  teacherFacilitators String[]         // plain text names

  // ── Schedule & Location ────────────────────────────────
  categoryId          String?
  category            ProgramCategory? @relation(fields: [categoryId], references: [id])
  dateText            String?          // override display label; blank = auto-generated
  timeText            String?          // override time display (e.g. "7-9 PM"); blank = auto from startDatetime
  programFormat       String           @default("in-person") // "in-person" | "virtual" | "hybrid"
  venue               String           @default("at-rim")    // "at-rim" | "other"
  locationText        String?
  locationLink        String?
  zoomLink            String?
  meetHostAccount     String?
  calendarEventId     String?
  livekitRoom         String?   // LiveKit room name — replaces zoomLink/meetHostAccount
  isOpenAccess        Boolean   @default(false) // allow non-members to join via guest link
  guestAccessKey      String?   // random key for guest join URL; reset invalidates old links
  startDatetime       DateTime?
  endDatetime         DateTime?
  recurrenceFreq      String?          // "DAILY" | "WEEKLY" | "MONTHLY"
  recurrenceInterval  Int?
  recurrenceDays      String[]         // ["MO","WE","SA"] etc
  recurrenceCount     Int?

  // ── Registration ───────────────────────────────────────
  registrationEnabled  Boolean   @default(false)
  registrationClosed   Boolean   @default(false)
  registrationCapacity Int?
  registrationDeadline DateTime?
  registrationFields   Json?     // [{label, fieldType, required, options[]}]
  confirmationMessage  Json?     // BlockNote JSON (RimProseEditor)
  reminderDate         DateTime?
  reminderMessage      Json?     // BlockNote JSON (RimProseEditor)

  // ── Dana ───────────────────────────────────────────────
  danaMode        String  @default("none") // "none"|"voluntary"|"base_plus_dana"|"fixed"
  suggestedDana   Float?
  danaBaseAmount  Float?
  danaFixedAmount Float?
  danaMessage     Json?    // BlockNote JSON (RimProseEditor)
  danaText        String?

  // ── Dashboard ──────────────────────────────────────────
  specialAnnouncement  String?
  earlyArrivalMessage  String?
  hideFromDashboard    Boolean  @default(false)
  dayOfWeek            String[] // ["MO","TH"] — drives "Today" badge + listing day group

  // ── Visibility ─────────────────────────────────────────
  sortOrder              Int?
  removeFromProgramList  Boolean @default(false)
  hideFromProgramPageList Boolean @default(false)
  archivedAt             DateTime?

  // ── Relations ──────────────────────────────────────────
  registrations      Registration[]
  programCourses     ProgramCourse[]
  sessionAttendances SessionAttendance[]
  programTeachers    ProgramTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("programs")
}

// ─── PROGRAM REGISTRATIONS ────────────────────────────────────────────────────

model Registration {
  id             String             @id @default(cuid())

  // Program — FK to Postgres Program table (migrated from Sanity)
  programId      String?
  program        Program?           @relation(fields: [programId], references: [id])
  programSlug    String             // for URL routing + HostAssignment join key
  programTitle   String             // snapshot at registration time

  // User — nullable (non-members get an account created on submit)
  userId         String?

  // Standard fields
  email          String
  firstName      String
  lastName       String
  phone          String?

  // Dynamic fields from Sanity registrationFields config
  customFields   Json?              // { "question label": "answer value" }

  // Registration status
  status           RegistrationStatus @default(REGISTERED)
  waitlistPosition Int?               // null if not waitlisted

  // Volunteer notes (internal only)
  notes          Json?

  // Donation (Stripe)
  donationStatus  DonationStatus  @default(NOT_REQUIRED)
  donationAmount  Int?            // in cents
  stripeSessionId String?

  // Self-service response edit link (single-use, 7-day expiry)
  editToken          String?   @unique
  editTokenExpiresAt DateTime?

  // Reminder email tracking — set when reminder is sent (auto or manual)
  reminderSentAt     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([programSlug, status])
  @@index([userId])
  @@index([programId])
  @@map("registrations")
}

enum RegistrationStatus {
  REGISTERED  // confirmed, under capacity
  WAITLISTED  // capacity reached
  APPROVED    // promoted from waitlist
  CANCELLED
}

enum DonationStatus {
  NOT_REQUIRED  // waitlisted — hold until approved
  PENDING       // registered or approved, donation not yet made
  COMPLETED     // donation received
  WAIVED        // volunteer marked as no donation needed
}

// ─── COURSE ACCESS (manual admin grants) ─────────────────────────────────────
// Registration-based access is checked dynamically; this table is for admin grants only.

model CourseAccess {
  id         String   @id @default(cuid())
  userId     String
  courseSlug String
  grantedBy  String?  // userId of the admin who granted access
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseSlug], references: [slug], onDelete: Cascade)

  @@unique([userId, courseSlug])
  @@map("course_access")
}

// ─── COURSES & LESSONS (Postgres-native) ─────────────────────────────────────
// Replaces Sanity courses + lessons. Managed via Teacher Hub.
// CourseAccess (manual admin grants above) still uses courseSlug — unchanged.

enum CourseAccessLevel {
  ALL_MEMBERS
  REGISTRATION_REQUIRED
  ROLE_REQUIRED
}

enum EnrollmentSource {
  SELF
  PROGRAM
  ROLE
  ONBOARDING
  ADMIN
}

// Admin-managed categories for organizing the series library.
model CourseCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  courses Course[]

  @@map("course_categories")
}

model Course {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title                 String
  slug                  String            @unique
  subheading            String?
  description           Json?             // BlockNote JSON
  accessLevel           CourseAccessLevel @default(ALL_MEMBERS)
  hideFromMemberProfile Boolean           @default(false)
  sortOrder             Int?
  isActive              Boolean           @default(true)
  isOnboarding          Boolean           @default(false) // auto-enroll all new members

  // Categorization & access
  categoryId    String?
  requiredRoles Role[]    // only used when accessLevel = ROLE_REQUIRED

  // Completion & presentation
  completionNote    String?  // shown when member completes the series
  discussionEnabled Boolean  @default(false)
  showDana          Boolean  @default(true)

  // Drip / cohort pacing
  dripEnabled        Boolean @default(false)
  dripIntervalDays   Int?    // days between lesson releases (when dripEnabled)
  hideLockedLessons  Boolean @default(false) // if true, locked lessons are hidden from members entirely
  cohortProgramId    String? // links to a Program for cohort-based pacing

  category    CourseCategory?    @relation(fields: [categoryId], references: [id])
  lessons     CourseLesson[]
  programs    ProgramCourse[]
  access      CourseAccess[]
  enrollments SeriesEnrollment[]

  @@index([slug])
  @@map("courses")
}

model Lesson {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titleInternal   String
  titleDisplayed  String
  slug            String   @unique

  accessLevel     CourseAccessLevel @default(ALL_MEMBERS)
  body            Json?    // BlockNote JSON

  heroImageUrl    String?  // Vercel Blob URL
  heroImageAlt    String?
  audioUrl        String?  // Vercel Blob URL
  videoUrl        String?  // YouTube or Vimeo URL

  headerQuote     String?
  quoteSource     String?

  resources       Json?    // { name, url, resourceType }[]

  releaseDate      DateTime? // fixed-date release; overrides interval if set
  releaseDelayDays Int?      // per-lesson override of dripIntervalDays

  // Learning system
  durationMinutes   Int?     // estimated reading/listening time shown on lesson cards
  reflectionPrompt  String?  // optional invitation shown at the bottom of the lesson
  questionsRequired Boolean  @default(false) // if true, all questions must be correct before Complete button activates

  courses   CourseLesson[]
  teachers  LessonTeacher[]
  progress  LessonProgress[]
  notes     LessonNote[]
  questions ReflectionQuestion[]
  dripNotifications DripNotification[]

  @@index([slug])
  @@map("lessons")
}

// One-to-one public profile for members flagged as teachers.
model TeacherProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  bio      String?
  photoUrl String?
  slug     String? @unique
  isPublic Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

// Many-to-many: Lesson ↔ User (member flagged as teacher)
model LessonTeacher {
  id       String @id @default(cuid())
  lessonId String
  userId   String
  order    Int    @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@map("lesson_teachers")
}

model ProgramTeacher {
  id        String @id @default(cuid())
  programId String
  userId    String
  order     Int    @default(0)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@map("program_teachers")
}

model DripNotification {
  id       String   @id @default(cuid())
  userId   String
  lessonId String
  sentAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("drip_notifications")
}

model CourseLesson {
  courseId   String
  lessonId   String
  sortOrder  Int     @default(0)
  groupLabel String? // Section header rendered before this lesson on the series page

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([courseId, lessonId])
  @@index([courseId, sortOrder])
  @@map("course_lessons")
}

model ProgramCourse {
  programId  String
  courseId   String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([programId, courseId])
  @@map("program_courses")
}

// ─── LEARNING SYSTEM ──────────────────────────────────────────────────────────
// Progress tracking, enrollment, and personal notes for the series/lesson library.

// Tracks which lessons a member has marked complete.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// Tracks conscious enrollment in a series (separate from access).
// Sets a start date and drives dashboard "Active Series" integration.
// completedAt is set when the member marks all lessons in the series complete.
model SeriesEnrollment {
  id               String           @id @default(cuid())
  userId           String
  courseId         String
  enrolledAt       DateTime         @default(now())
  completedAt      DateTime?
  enrollmentSource EnrollmentSource @default(SELF)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("series_enrollments")
}

// Personal notes a member writes while going through a lesson.
// Stored as BlockNote JSON (RimProseEditor).
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  body      Json?
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}


// Multiple-choice reflection questions attached to a lesson.
// Teachers write questions + options; one option is marked correct.
model ReflectionQuestion {
  id       String @id @default(cuid())
  lessonId String
  body     Json?  // BlockNote JSON (RimProseEditor)
  sortOrder Int    @default(0)

  lesson  Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options ReflectionOption[]

  @@index([lessonId])
  @@map("reflection_questions")
}

// Answer options for a ReflectionQuestion.
model ReflectionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question  ReflectionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses ReflectionResponse[]

  @@index([questionId])
  @@map("reflection_options")
}

// A member's selected answer for a specific question.
// Upserted on every submit; retakes overwrite the previous answer.
model ReflectionResponse {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  optionId   String
  answeredAt DateTime @default(now()) @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  option   ReflectionOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("reflection_responses")
}

// ─── DONATION MANAGEMENT (Phase 2) ───────────────────────────────────────────
// Unified log of all contributions regardless of source.
// Registration-linked Stripe donations are also captured here via webhook.

model Donation {
  id            String         @id @default(cuid())

  // Source tracking
  source        DonationSource
  amountCents   Int            // always stored in cents
  currency      String         @default("usd")
  donatedAt     DateTime

  // Donor info (optional — cash donations may be anonymous)
  userId        String?        // linked RIM member, if known
  donorName     String?
  donorEmail    String?

  // Program context (optional — not all donations are program-linked)
  programId     String?        // Sanity _id
  programTitle  String?

  // Registration link (for Stripe registration-flow donations)
  registrationId String?

  // Source-specific reference IDs
  stripePaymentIntentId   String?  @unique
  stripeCheckoutSessionId String?
  givebutterId            String?  // GiveButter transaction ID

  // Reconciliation
  notes         String?        // for cash/check: e.g. "envelope received 3/2"
  quickbooksRef String?        // QB transaction ID (future)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("donations")
}

enum DonationSource {
  STRIPE        // registration flow or direct link
  GIVEBUTTER    // imported from GiveButter
  CASH          // manually entered by treasurer
  CHECK         // manually entered by treasurer
  OTHER
}

// ─── HOST COMMUNITY HUB ──────────────────────────────────────────────────────
// Self-managed by HOST_MANAGER; independent of Registrar workflow.
// ⚠️ programSlug is the join key to Sanity — never change a slug after assignment.

// Who is responsible for hosting a specific program session.
// userId null = unclaimed session (seeded by HOST_MANAGER; open for anyone to claim).
// userId set + no open SubRequest = claimed.
// userId set + open SubRequest = sub needed.
// sessionDate null = "standing" (covers all occurrences; legacy concept — new sessions always have a date).
model HostAssignment {
  id          String    @id @default(cuid())
  programSlug String    // Sanity slug — treated as a stable, permanent identifier
  sessionDate DateTime? // null = standing; set = specific session date
  userId      String?   // null = unclaimed session
  user        User?     @relation("HostAssignments", fields: [userId], references: [id], onDelete: SetNull)
  assignedBy  String?   // userId of HOST_MANAGER/ADMIN who created this
  notes       String?
  subRequests SubRequest[]
  createdAt   DateTime  @default(now())

  @@unique([programSlug, sessionDate])
  @@map("host_assignments")
}

// A host requesting coverage for one of their sessions.
model SubRequest {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   HostAssignment @relation(fields: [assignmentId], references: [id])
  programSlug  String         // denormalized for display without join
  sessionDate  DateTime?      // specific date (for recurring programs); null = next/all
  status       SubStatus      @default(OPEN)
  message      Json?          // context for potential claimers (BlockNote JSON)
  claim        SubClaim?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("sub_requests")
}

// A hub member volunteering to cover a sub request.
model SubClaim {
  id          String     @id @default(cuid())
  requestId   String     @unique
  request     SubRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  claimedById String
  claimedBy   User       @relation("SubClaims", fields: [claimedById], references: [id], onDelete: Cascade)
  message     Json?      // optional note to the original host (BlockNote JSON)
  createdAt   DateTime   @default(now())

  @@map("sub_claims")
}

enum SubStatus {
  OPEN
  CLAIMED
  CANCELLED
}

// HostThread and HostReply models removed in session 76 (hub conformance).
// Features (reactions, reply editing, categories) ported to shared HubConversationThread/Reply.
// Tables host_threads and host_replies retained in DB for historical reference.

// ─── APP SETTINGS (key-value) ─────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ─── SITE-WIDE ALERTS ────────────────────────────────────────────────────────
// First consumer: host hub. Other modules will add AlertType values as needed.

model Alert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("Alerts", fields: [userId], references: [id], onDelete: Cascade)
  type      AlertType
  message   String
  linkUrl   String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@map("alerts")
}

enum AlertType {
  SUB_REQUEST        // all hub members: someone needs a sub
  SUB_CLAIMED        // original requester only: your sub was claimed
  NEW_THREAD         // all hub members: new thread posted
  NEW_REPLY          // thread author + prior repliers: new reply on a thread you're in
  UNASSIGNED_SESSION // HOST_MANAGER + ADMIN: program within 30 days has no host assigned
  SUPPORT_ASSIGNED   // support team: thread assigned to you
  SUPPORT_NEW_REPLY  // support team: new reply on your assigned thread
  SUPPORT_NEW_NOTE   // support team: internal note added to your assigned thread
  TASK_ASSIGNED      // hub member: task assigned to you
  TASK_DUE_TOMORROW  // hub member: task due tomorrow
}

// ─── SESSION ATTENDANCE ───────────────────────────────────────────────────────
// Records when a logged-in member clicks a Meet link from within their account session.
// isNewMember and returningAfterAbsence are computed at record creation time.
// Surfaced as a scoped projection in the Host Team hub — not in the Member Registry.
// programId is a Sanity _id string — no local FK relation.

model SessionAttendance {
  id                    String            @id @default(cuid())
  userId                String
  programId             String?           // Postgres Program.id (migrated from Sanity _id)
  program               Program?          @relation(fields: [programId], references: [id])
  programSlug           String            // stable slug — kept as denormalized join key
  sessionDate           DateTime?         // CT midnight for the session date — always set by API; nullable for migration safety
  joinedAt              DateTime          @default(now())
  leftEarly             Boolean           @default(false)
  isNewMember           Boolean           @default(false)
  returningAfterAbsence Boolean           @default(false)
  flaggedByHost         Boolean           @default(false)
  postSessionNote       Json?     // BlockNote JSON (RimProseEditor)
  postSessionAction     PostSessionAction @default(NONE)
  actionRouted          Boolean           @default(false)
  createdAt             DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programSlug, sessionDate])
  @@index([programSlug])
  @@index([userId])
  @@index([programSlug, joinedAt])
  @@map("session_attendance")
}

// One record per session per date. Created/updated on post-session form submission.
// Holds session-level data: host reflection and optional resource for attendees.
// sessionDate is always stored as midnight CT — normalized consistently on every write.

model SessionReport {
  id                      String    @id @default(cuid())
  programSlug             String    // Sanity slug
  sessionDate             DateTime  // Date of session — stored as midnight CT
  hostId                  String    // FK → User (host who submitted)
  submittedByAssignedHost Boolean?  // null = no assignment; true = submitter matched; false = someone else submitted
  reflection              Json?     // BlockNote JSON (RimProseEditor)
  resourceUrl             String?   // URL or text to share with all attendees
  resourceNote            String?   // Brief description of the resource
  resourceRouted          Boolean   @default(false)  // Set when resource has been sent to support/registrar
  submittedAt             DateTime  @default(now())
  sessionEndedAt          DateTime? // Set when a host clicks "Close session" — hard cutoff for join window

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([programSlug, sessionDate])
  @@map("session_reports")
}

enum PostSessionAction {
  NONE
  GENTLE_FOLLOWUP
  JESSE_ONLY
  TECHNICAL_ISSUE
}

// Self-marked co-hosts for a session.
// Any Host Team member can tap "I'm also hosting this" in States 2 or 3.
// Records them for the live view and queues a reflection prompt after the session.
model SessionCoHost {
  id          String   @id @default(cuid())
  programSlug String
  sessionDate DateTime // CT midnight for the session date
  userId      String
  user        User     @relation("SessionCoHosts", fields: [userId], references: [id], onDelete: Cascade)
  isPrimary   Boolean  @default(false) // true when no HostAssignment existed at time of self-mark
  createdAt   DateTime @default(now())

  @@unique([programSlug, sessionDate, userId])
  @@map("session_cohosts")
}

// Reflection submitted by a co-host after a session.
// Separate from SessionReport (which is the primary host's full report).
// Both appear in the team journal.
model SessionCoHostReport {
  id          String   @id @default(cuid())
  programSlug String
  sessionDate DateTime // CT midnight for the session date
  userId      String
  user        User     @relation("SessionCoHostReports", fields: [userId], references: [id], onDelete: Cascade)
  reflection  Json?    // BlockNote JSON (RimProseEditor)
  submittedAt DateTime @default(now())

  @@unique([programSlug, sessionDate, userId])
  @@map("session_cohost_reports")
}

// ─── HUB ACCESS (person-level) ────────────────────────────────────────────────
// Replaces role-baked hub access checks with explicit per-person, per-hub grants.
// Carries an audit trail (grantedAt, grantedById).
// ADMIN users bypass this table entirely — see lib/hubAuth.ts.

model UserHubAccess {
  id          String   @id @default(cuid())
  userId      String
  hubSlug     String
  grantedAt   DateTime @default(now())
  grantedById String?

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("HubAccessGranter", fields: [grantedById], references: [id])

  @@unique([userId, hubSlug])
  @@map("user_hub_access")
}

model UserToolAccess {
  id          String   @id @default(cuid())
  userId      String
  toolSlug    String   // "learning", "programs", "inbox", "schedule"
  grantedAt   DateTime @default(now())
  grantedById String?

  user      User  @relation("ToolAccess", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("ToolAccessGranter", fields: [grantedById], references: [id])

  @@unique([userId, toolSlug])
  @@map("user_tool_access")
}

// ─── MULTI-HUB SYSTEM ────────────────────────────────────────────────────────
// Generic workspace system for any volunteer team. Each hub has tabs:
// Announcements (default), Documents, Conversations, Members, + optional Schedule.
// Access is driven by HubMember records, not by Role enum values.

enum HubType {
  OPERATIONAL
  GOVERNANCE
  COMMUNITY_GROUP
}

enum HubStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum HubDocumentFileType {
  DOC
  SHEET
  SLIDE
  FORM
  LINK
}

model Hub {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  name                   String
  type                   HubType
  description            String?
  status                 HubStatus     @default(ACTIVE)
  hasSchedule            Boolean       @default(false)
  welcomeHeadline        String?
  welcomeBody            Json?
  homeContent            Json?
  documentCategories     String[]      @default([])
  conversationCategories String[]      @default(["General"])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  members       HubMember[]
  documents     HubDocument[]
  threads       HubConversationThread[]
  appLinks      HubAppLink[]
  taskLists     TaskList[]

  @@map("hubs")
}

model HubAppLink {
  id        String  @id @default(cuid())
  hubId     String
  toolSlug  String?
  label     String
  href      String
  order     Int     @default(0)
  isEnabled Boolean @default(true)

  hub       Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@map("hub_app_links")
}

model TaskList {
  id          String   @id @default(cuid())
  hubId       String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  isTemplate  Boolean  @default(false)
  order       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hub         Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TaskListCreatedBy", fields: [createdById], references: [id])
  tasks       Task[]

  @@map("task_lists")
}

model Task {
  id          String     @id @default(cuid())
  listId      String
  title       String
  body        Json?
  assigneeId  String?
  dueDate     DateTime?
  status      TaskStatus @default(OPEN)
  order       Int        @default(0)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  list        TaskList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  subtasks    Subtask[]

  @@map("tasks")
}

model Subtask {
  id          String     @id @default(cuid())
  taskId      String
  title       String
  body        Json?
  assigneeId  String?
  dueDate     DateTime?
  status      TaskStatus @default(OPEN)
  order       Int        @default(0)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("SubtaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User       @relation("SubtaskCreatedBy", fields: [createdById], references: [id])

  @@map("subtasks")
}

model HubMember {
  id            String    @id @default(cuid())
  hubId         String
  userId        String
  position      String?   // e.g. "Virtual Host Coordinator" — free text label
  isCoordinator Boolean   @default(false)
  joinedAt      DateTime  @default(now())
  lastVisitedAt  DateTime? // for unread dot tracking on dashboard hub cards
  firstVisitedAt DateTime? // for newcomer welcome interstitial (Phase 2c)

  hub  Hub  @relation(fields: [hubId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hubId, userId])
  @@map("hub_members")
}

model HubDocument {
  id          String              @id @default(cuid())
  hubId       String
  addedById   String
  label       String
  url         String?             // nullable — native docs have no external URL
  description String?
  fileType    HubDocumentFileType @default(LINK)
  category    String?
  body        Json?               // BlockNote JSON — set when isNative = true
  isNative    Boolean             @default(false)
  isLocked    Boolean             @default(false) // Author can lock to prevent edits
  editingById String?             // Currently editing — presence tracking
  editingAt   DateTime?           // When the editor was last opened/heartbeat

  hub        Hub      @relation(fields: [hubId], references: [id])
  addedBy    User     @relation("HubDocumentAuthor", fields: [addedById], references: [id], onDelete: Cascade)
  editingBy  User?    @relation("HubDocumentEditor", fields: [editingById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("hub_documents")
}

model HubConversationThread {
  id                   String    @id @default(cuid())
  hubId                String
  authorId             String
  title                String
  body                 Json?
  category             String    @default("General")
  status               String    @default("OPEN")
  isPinned             Boolean   @default(false)
  pinnedAt             DateTime?

  hub           Hub               @relation(fields: [hubId], references: [id])
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies       HubConversationReply[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("hub_conversation_threads")
}

model HubConversationReply {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  body      Json?
  edited    Boolean   @default(false)
  editedAt  DateTime?
  reactions Json      @default("{}")

  thread    HubConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("hub_conversation_replies")
}

// ─── EMAIL TEMPLATE MANAGER ───────────────────────────────────────────────────
// Slugs are permanent system identifiers — never delete, never rename.
// Enabled = false means sendTemplatedEmail() silently no-ops for that slug.

model EmailTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  subject     String
  body        String   @db.Text
  enabled     Boolean  @default(false)
  variables   String[]

  // Grouping for the admin list view
  group       String   @default("general")
  groupLabel  String   @default("General")
  // Minimum role required to view/edit this template (default: ADMIN)
  minRole     String   @default("ADMIN")

  // Help text displayed above the subject line in the editor
  helpText    String?
  // Callout for variables that originate in Sanity Studio (rendered distinctly)
  sanityNote  String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("email_templates")
}

// ─── SUPPORT INBOX ──────────────────────────────────────────────────────────
// Gmail integration for support@rootedinmindfulness.org.
// Threads and messages are synced from Gmail; notes are internal-only.

enum SupportStatus {
  OPEN
  CLAIMED
  WAITING
  RESOLVED
}

model GmailCredential {
  id           String   @id @default(cuid())
  email        String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gmail_credentials")
}

model SupportThread {
  id            String        @id @default(cuid())
  gmailThreadId String        @unique
  subject       String
  status        SupportStatus @default(OPEN)
  assignedToId  String?
  assignedTo    User?         @relation("ThreadAssignee", fields: [assignedToId], references: [id])
  memberId      String?
  member        User?         @relation("ThreadMember", fields: [memberId], references: [id])
  senderEmail   String
  senderName    String?
  messages      SupportMessage[]
  notes         SupportNote[]
  lastMessageAt DateTime
  lastSyncedAt  DateTime      @default(now())
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@map("support_threads")
}

model SupportMessage {
  id             String        @id @default(cuid())
  gmailMessageId String        @unique
  threadId       String
  thread         SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromEmail      String
  fromName       String?
  bodyHtml       String        @db.Text
  bodyText       String        @db.Text
  attachments    Json?         // CID map: [{ cid, attachmentId, mimeType, filename }]
  fileAttachments SupportAttachment[]
  sentAt         DateTime
  isOutbound     Boolean       @default(false)
  sentById       String?
  sentBy         User?         @relation("MessageSender", fields: [sentById], references: [id])

  @@index([threadId])
  @@map("support_messages")
}

model SupportAttachment {
  id                String         @id @default(cuid())
  messageId         String
  message           SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  gmailAttachmentId String
  filename          String
  mimeType          String
  size              Int

  @@index([messageId])
  @@map("support_attachments")
}

model SupportNote {
  id        String        @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("NoteAuthor", fields: [authorId], references: [id])
  body      Json
  createdAt DateTime      @default(now())

  @@index([threadId])
  @@map("support_notes")
}

model SupportSignature {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  tagline String  @default("RIM Support")
  role    String?

  @@map("support_signatures")
}

model SupportTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String   @default("")
  body      Json?
  createdById String
  createdBy User     @relation("TemplateCreator", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_templates")
}

// ─── MANUAL / CONTEXTUAL HELP ─────────────────────────────────────────────────

model ManualSection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  hubSlug     String?
  body        Json?
  relations   String[]
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("manual_sections")
}

// ─── SITE-WIDE BANNER ────────────────────────────────────────────────────────
// Single-slot broadcast for community-wide notices (cancellations, etc.).
// ADMIN posts and dismisses globally; members can dismiss individually.

model SiteBanner {
  id          String    @id @default(cuid())
  body        Json?     // BlockNote JSON (RimProseEditor)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation("SiteBannerCreator", fields: [createdById], references: [id])

  dismissals  SiteBannerDismissal[]

  @@map("site_banners")
}

model SiteBannerDismissal {
  id       String     @id @default(cuid())
  bannerId String
  userId   String
  banner   SiteBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user     User       @relation("SiteBannerDismissal", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bannerId, userId])
  @@map("site_banner_dismissals")
}
