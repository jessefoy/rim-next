// RIM Member Management Database Schema
// Prisma + Vercel Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── AUTH (required by NextAuth/Auth.js) ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── MEMBER PROFILE ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  firstName     String?
  lastName      String?
  phone         String?
  roles         Role[]    @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Community membership threshold
  agreedToTerms Boolean   @default(false)
  agreedAt      DateTime?

  // Soft-delete: archived members cannot log in but their records are preserved
  archivedAt    DateTime?

  // Legacy data imported from Memberstack (kept for historical reference)
  legacyMemberstackId     String?   @unique
  legacyLastLogin         DateTime?
  legacyLastAttendance    DateTime?
  legacyActivityCount     Int?
  legacyMemberSince       DateTime?

  // Relations
  accounts      Account[]
  sessions      Session[]
  memberships   UserMembership[]
  attendance    AttendanceRecord[]
  registrations Registration[]
  courseAccess  CourseAccess[]

  @@map("users")
}

enum Role {
  REGISTRAR   // manages program registrations
  TREASURER   // views donation reports, manages donation records
  TEACHER     // content access, profile page
  VOLUNTEER   // general volunteer
  ADMIN       // full access
}

// ─── MEMBERSHIP TYPES ────────────────────────────────────────────────────────

model MembershipType {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. "General Member", "Dharma Study Group"
  slug        String   @unique  // e.g. "general", "dharma-study-group"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  members UserMembership[]

  @@map("membership_types")
}

model UserMembership {
  id               String         @id @default(cuid())
  userId           String
  membershipTypeId String
  joinedAt         DateTime       @default(now())
  isActive         Boolean        @default(true)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id])

  @@unique([userId, membershipTypeId])
  @@map("user_memberships")
}

// ─── ATTENDANCE (Phase 2 — table created now, populated later) ───────────────

model AttendanceRecord {
  id          String           @id @default(cuid())
  userId      String
  recordedAt  DateTime         @default(now())
  eventDate   DateTime
  eventName   String
  eventType   AttendanceType
  format      AttendanceFormat
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

enum AttendanceType {
  CLASS
  RETREAT
  STUDY_GROUP
  VOLUNTEER
  EVENT
}

enum AttendanceFormat {
  IN_PERSON
  ONLINE
}

// ─── PROGRAM REGISTRATIONS ────────────────────────────────────────────────────

model Registration {
  id             String             @id @default(cuid())

  // Program (sourced from Sanity)
  programId      String             // Sanity _id
  programSlug    String             // for URL routing
  programTitle   String             // snapshot at registration time

  // User — nullable (non-members get an account created on submit)
  userId         String?

  // Standard fields
  email          String
  firstName      String
  lastName       String
  phone          String?

  // Dynamic fields from Sanity registrationFields config
  customFields   Json?              // { "question label": "answer value" }

  // Registration status
  status           RegistrationStatus @default(REGISTERED)
  waitlistPosition Int?               // null if not waitlisted

  // Volunteer notes (internal only)
  notes          String?

  // Donation (Stripe)
  donationStatus  DonationStatus  @default(NOT_REQUIRED)
  donationAmount  Int?            // in cents
  stripeSessionId String?

  // Self-service response edit link (single-use, 7-day expiry)
  editToken          String?   @unique
  editTokenExpiresAt DateTime?

  // Reminder email tracking — set when reminder is sent (auto or manual)
  reminderSentAt     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User?     @relation(fields: [userId], references: [id])

  @@map("registrations")
}

enum RegistrationStatus {
  REGISTERED  // confirmed, under capacity
  WAITLISTED  // capacity reached
  APPROVED    // promoted from waitlist
  CANCELLED
}

enum DonationStatus {
  NOT_REQUIRED  // waitlisted — hold until approved
  PENDING       // registered or approved, donation not yet made
  COMPLETED     // donation received
  WAIVED        // volunteer marked as no donation needed
}

// ─── COURSE ACCESS (manual admin grants) ─────────────────────────────────────
// Registration-based access is checked dynamically; this table is for admin grants only.

model CourseAccess {
  id         String   @id @default(cuid())
  userId     String
  courseSlug String
  grantedBy  String?  // userId of the admin who granted access
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
  @@map("course_access")
}

// ─── DONATION MANAGEMENT (Phase 2) ───────────────────────────────────────────
// Unified log of all contributions regardless of source.
// Registration-linked Stripe donations are also captured here via webhook.

model Donation {
  id            String         @id @default(cuid())

  // Source tracking
  source        DonationSource
  amountCents   Int            // always stored in cents
  currency      String         @default("usd")
  donatedAt     DateTime

  // Donor info (optional — cash donations may be anonymous)
  userId        String?        // linked RIM member, if known
  donorName     String?
  donorEmail    String?

  // Program context (optional — not all donations are program-linked)
  programId     String?        // Sanity _id
  programTitle  String?

  // Registration link (for Stripe registration-flow donations)
  registrationId String?

  // Source-specific reference IDs
  stripePaymentIntentId   String?  @unique
  stripeCheckoutSessionId String?
  givebutterId            String?  // GiveButter transaction ID

  // Reconciliation
  notes         String?        // for cash/check: e.g. "envelope received 3/2"
  quickbooksRef String?        // QB transaction ID (future)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("donations")
}

enum DonationSource {
  STRIPE        // registration flow or direct link
  GIVEBUTTER    // imported from GiveButter
  CASH          // manually entered by treasurer
  CHECK         // manually entered by treasurer
  OTHER
}
