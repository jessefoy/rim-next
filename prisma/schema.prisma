// RIM Member Management Database Schema
// Prisma + Vercel Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── AUTH (required by NextAuth/Auth.js) ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── MEMBER PROFILE ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  firstName     String?
  lastName      String?
  phone         String?
  roles         Role[]    @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Community membership threshold
  agreedToTerms Boolean   @default(false)
  agreedAt      DateTime?

  // Soft-delete: archived members cannot log in but their records are preserved
  archivedAt    DateTime?

  // Photos
  avatarUrl       String?  // Presence photo shown in video sessions and on profile; set from profile or in-session

  // Extended profile fields
  preferredName   String?
  title           String?     // Display title: "Guiding Teacher", "Program Registrar", etc.
  addressLine1    String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  memberStatus    MemberStatus @default(ACTIVE)
  firstVisitDate  DateTime?
  adminNotes      Json?             // BlockNote JSON (RimProseEditor)
  bio             Json?             // BlockNote JSON — personal description, separate from any role
  tags            String[]     @default([])
  // Viewer-level section access grants — sections this person can view on other member profiles
  // without holding the team role. Admin-assigned. Example values: "admin-notes", "care-notes"
  sectionGrants   String[]     @default([])

  // Learning system
  lessonProgress      LessonProgress[]
  seriesEnrollments   SeriesEnrollment[]
  lessonNotes         LessonNote[]
  isTeacher           Boolean        @default(false)
  teacherProfile      TeacherProfile?
  lessonTeachers      LessonTeacher[]
  programTeachers     ProgramTeacher[]

  // Legacy data imported from Memberstack (kept for historical reference)
  legacyLastLogin         DateTime?
  legacyLastAttendance    DateTime?
  legacyActivityCount     Int?
  legacyMemberSince       DateTime?

  // Relations
  accounts        Account[]
  sessions        Session[]
  registrations   Registration[]
  courseAccess    CourseAccess[]
  household       HouseholdMember?
  hostAssignments HostAssignment[]   @relation("HostAssignments")
  subClaims       SubClaim[]         @relation("SubClaims")
  // Hub system
  hubMemberships  HubMember[]
  hubDocuments            HubDocument[] @relation("HubDocumentAuthor")
  hubDocumentsEditing     HubDocument[] @relation("HubDocumentEditor")
  hubDocumentsArchived    HubDocument[] @relation("HubDocumentArchiver")
  hubDocumentsTrashed     HubDocument[] @relation("HubDocumentTrasher")
  hubDocumentNotifications HubDocumentNotification[]
  hubThreads2     HubConversationThread[]
  hubThreadsArchived HubConversationThread[] @relation("HubThreadArchiver")
  hubThreadsTrashed HubConversationThread[] @relation("HubThreadTrasher")
  hubReplies2     HubConversationReply[]
  hubThreadSubscriptions HubThreadSubscription[]
  emailTemplates  EmailTemplate[]
  // Tool access grants (individual access without role)
  toolAccess           UserToolAccess[]      @relation("ToolAccess")
  toolAccessGranted    UserToolAccess[]      @relation("ToolAccessGranter")
  standingAssignments        StandingAssignment[] @relation("StandingAssignmentHost")
  standingAssignmentsCreated StandingAssignment[] @relation("StandingAssignmentCreator")

  @@map("users")
}

enum Role {
  HOST                 // Zoom host rotation — access to host hub; can host sessions + claim subs
  HOST_MANAGER         // manages host schedule and community; full hub read/write
  REGISTRAR            // manages program registrations
  ADMIN                // full access
  TEACHER              // course/lesson management via Course Manager tool
  SUPPORT              // support inbox — reads/replies to support@rootedinmindfulness.org
  GUIDING_TEACHER      // dharma authority — manages hub trash alongside admin + coordinators
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
  STUDENT
  VOLUNTEER
}

enum RelationshipType {
  SPOUSE
  PARTNER
  PARENT
  CHILD
  SIBLING
  OTHER
}

// ─── HOUSEHOLDS ──────────────────────────────────────────────────────────────

model Household {
  id           String   @id @default(cuid())
  name         String?  // e.g. "The Smith Family" — optional display name
  addressLine1 String?
  addressCity  String?
  addressState String?
  addressZip   String?
  notes        Json?       // BlockNote JSON (RimProseEditor)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members HouseholdMember[]

  @@map("households")
}

model HouseholdMember {
  id                 String           @id @default(cuid())
  householdId        String
  userId             String           @unique  // one household per member (enforced at DB level)
  relationshipType   RelationshipType @default(OTHER)
  relationshipCustom String?          // only when type = OTHER; logged for future enum promotion
  isPrimary          Boolean          @default(false)
  createdAt          DateTime         @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("household_members")
}



// ─── PROGRAMS (migrated from Sanity) ──────────────────────────────────────────

model ProgramCategory {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  sortOrder            Int       @default(0)
  hideFromProgramsPage Boolean   @default(false)
  // Structural offering KIND (session 137). Stable code from lib/programKind.ts
  // (DROP_IN | COMMUNITY_GROUP | CLASS | EVENT | RETREAT | SERVICE | PRIVATE).
  // The category NAME stays editorial/editable; `kind` is the behavior-driving
  // attribute (dashboard placement, registration semantics). A program inherits
  // its kind from its category. Nullable for safety; null falls back to
  // registration-based behavior. See RIM_Offering_Model.md "Two axes, one switch".
  kind                 String?
  programs             Program[]

  @@map("program_categories")
}

model Program {
  id    String @id @default(cuid())
  slug  String @unique
  name  String

  // ── Content ────────────────────────────────────────────
  tagline             String?
  programImage        String?          // URL (Vercel Blob or external)
  description         Json?            // BlockNote JSON (RimBlockEditor)
  pullQuote           String?
  pullQuoteSource     String?
  programNotes        Json?            // BlockNote JSON (RimProseEditor) — Webflow "Program Notes" section
  specialNotes        Json?            // DEPRECATED (session 91) — content migrated into description as Aside block by the fold_special_notes_into_description_as_aside migration. Field kept for one release as safety net; remove in a later migration. Do not write new data to this field.
  teacherFacilitators String[]         // plain text names
  teacherLabel        String?          // pill label for ProgramTeachers in the session room. Null = "Teacher" (default). Coordinator can set per program — "Guide" for peer-led silent sits, "Facilitator" for Recovery Dharma, "Instructor" for Qigong, custom for anything else.
  hostingHubSlug      String?          // which hub hosts this program. Null = "host-team" (the default). Set to e.g. "peer-led-silent-meditation" to transfer hosting authority to a different hub. Slug-based join (not FK) for stability — mirrors HostAssignment.programSlug. See RIM_System_Architecture.md "Hub-as-authority for programs (session 128)".

  // ── Schedule & Location ────────────────────────────────
  categoryId          String?
  category            ProgramCategory? @relation(fields: [categoryId], references: [id])
  dateText            String?          // override display label; blank = auto-generated
  timeText            String?          // override time display (e.g. "7-9 PM"); blank = auto from startDatetime
  programFormat       String           @default("in-person") // "in-person" | "virtual" | "hybrid"
  venue               String           @default("at-rim")    // "at-rim" | "other"
  locationText        String?
  locationLink        String?
  zoomLink            String?
  meetHostAccount     String?
  calendarEventId     String?
  livekitRoom         String?   // LiveKit room name — replaces zoomLink/meetHostAccount
  isOpenAccess        Boolean   @default(false) // allow non-members to join via guest link
  guestAccessKey      String?   // random key for guest join URL; reset invalidates old links
  startDatetime       DateTime?
  endDatetime         DateTime?
  recurrenceFreq      String?          // "DAILY" | "WEEKLY" | "MONTHLY"
  recurrenceInterval  Int?
  recurrenceDays      String[]         // ["MO","WE","SA"] etc
  recurrenceCount     Int?

  // ── Registration ───────────────────────────────────────
  registrationEnabled  Boolean   @default(false)
  registrationClosed   Boolean   @default(false)
  registrationCapacity Int?
  registrationDeadline DateTime?
  registrationFields   Json?     // [{label, fieldType, required, options[]}]
  confirmationMessage  Json?     // BlockNote JSON (RimProseEditor)
  reminderDate         DateTime?
  reminderMessage      Json?     // BlockNote JSON (RimProseEditor)

  // ── Dana ───────────────────────────────────────────────
  danaMode        String  @default("none") // "none"|"voluntary"|"base_plus_dana"|"fixed"
  suggestedDana   Float?
  danaBaseAmount  Float?
  danaFixedAmount Float?
  danaMessage     Json?    // BlockNote JSON (RimProseEditor)
  danaText        String?

  // ── Dashboard ──────────────────────────────────────────
  specialAnnouncement  String?
  earlyArrivalMessage  String?
  hideFromDashboard    Boolean  @default(false)
  dayOfWeek            String[] // ["MO","TH"] — drives "Today" badge + listing day group

  // ── Visibility ─────────────────────────────────────────
  sortOrder                Int?
  removeFromProgramList    Boolean   @default(false)
  dashboardShowAt          DateTime? // if set, auto-shows on dashboards on this date even if removeFromProgramList is true
  hideFromProgramPageList  Boolean   @default(false)
  hideFromWeeklySchedule   Boolean   @default(false)
  archivedAt               DateTime?

  // ── Relations ──────────────────────────────────────────
  registrations      Registration[]
  programCourses     ProgramCourse[]
  programTeachers    ProgramTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("programs")
}

// Auxiliary-hub coverage for a program (session 129 — AV + Greeter hubs).
//
// `Program.hostingHubSlug` is the *primary* hub for a program — who runs the
// live session, owns the LiveKit room, holds dharma authority. A program may
// additionally need role coverage from other hubs (AV volunteer, greeters) for
// its in-person component. Each such relationship is one row here, keyed by
// program slug (matching the rest of the host-system slug-as-join-key
// convention — never change a program's slug after coverage exists).
//
// Read pattern: `getProgramCoverageHubs(programSlug)` returns the slugs of the
// auxiliary hubs covering this program. The Scheduler page unions a hub's
// primary programs (where `hostingHubSlug` matches) with its auxiliary
// programs (where a coverage row exists) and applies the hub's
// `appliesToFormats` filter on top.
model ProgramCoverageHub {
  programSlug String
  hubSlug     String
  createdAt   DateTime @default(now())

  @@id([programSlug, hubSlug])
  @@index([hubSlug])
  @@map("program_coverage_hubs")
}

// ─── PROGRAM REGISTRATIONS ────────────────────────────────────────────────────

model Registration {
  id             String             @id @default(cuid())

  // Program — FK to Postgres Program table (migrated from Sanity)
  programId      String?
  program        Program?           @relation(fields: [programId], references: [id])
  programSlug    String             // for URL routing + HostAssignment join key
  programTitle   String             // snapshot at registration time

  // User — nullable (non-members get an account created on submit)
  userId         String?

  // Standard fields
  email          String
  firstName      String
  lastName       String
  phone          String?

  // Dynamic fields from Sanity registrationFields config
  customFields   Json?              // { "question label": "answer value" }

  // Registration status
  status           RegistrationStatus @default(REGISTERED)
  waitlistPosition Int?               // null if not waitlisted

  // Volunteer notes (internal only)
  notes          Json?

  // Donation (Stripe)
  donationStatus  DonationStatus  @default(NOT_REQUIRED)
  donationAmount  Int?            // in cents
  stripeSessionId String?

  // Self-service response edit link (single-use, 7-day expiry)
  editToken          String?   @unique
  editTokenExpiresAt DateTime?

  // Reminder email tracking — set when reminder is sent (auto or manual)
  reminderSentAt     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([programSlug, status])
  @@index([userId])
  @@index([programId])
  @@map("registrations")
}

enum RegistrationStatus {
  PENDING_PAYMENT  // required-payment registration held until Stripe confirms — invisible to member/registrar views, holds a seat, auto-expires on abandonment
  REGISTERED       // confirmed, under capacity
  WAITLISTED       // capacity reached
  APPROVED         // promoted from waitlist
  CANCELLED
}

enum DonationStatus {
  NOT_REQUIRED  // waitlisted — hold until approved
  PENDING       // registered or approved, donation not yet made
  COMPLETED     // donation received
  WAIVED        // volunteer marked as no donation needed
}

// ─── COURSE ACCESS (manual admin grants) ─────────────────────────────────────
// Registration-based access is checked dynamically; this table is for admin grants only.

model CourseAccess {
  id         String   @id @default(cuid())
  userId     String
  courseSlug String
  grantedBy  String?  // userId of the admin who granted access
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseSlug], references: [slug], onDelete: Cascade)

  @@unique([userId, courseSlug])
  @@map("course_access")
}

// ─── COURSES & LESSONS (Postgres-native) ─────────────────────────────────────
// Replaces Sanity courses + lessons. Managed via Teacher Hub.
// CourseAccess (manual admin grants above) still uses courseSlug — unchanged.

enum CourseAccessLevel {
  ALL_MEMBERS
  REGISTRATION_REQUIRED
  ROLE_REQUIRED
}

enum EnrollmentSource {
  SELF
  PROGRAM
  ROLE
  ONBOARDING
  ADMIN
}

// Admin-managed categories for organizing the series library.
model CourseCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  courses Course[]

  @@map("course_categories")
}

model Course {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title                 String
  slug                  String            @unique
  subheading            String?
  description           Json?             // BlockNote JSON

  // ── Access model ──────────────────────────────────────────────────────────
  // Transitioning from the single `accessLevel` enum to orthogonal flags
  // (RIM_Offering_Model.md, decided session 118, schema slice session 123).
  // The enum is preserved during transition; reads migrate to flags first,
  // then the enum drops in a later pass. Backfill rules in migrate.mjs
  // (add_course_offering_flags) — every existing course preserves its
  // current access semantics under the new flags.
  accessLevel              CourseAccessLevel @default(ALL_MEMBERS) // PHASING OUT — reads migrate to flags below
  allowSelfEnroll          Boolean           @default(false)        // member sees an Enroll CTA on /course/[slug]
  selfEnrollDanaRequired   Boolean           @default(false)        // self-enroll routes through dana checkout first
  accessRestrictionMessage String?                                  // friendly per-course copy shown when visitor can't self-enroll

  hideFromMemberProfile  Boolean @default(false)
  sortOrder              Int?
  isActive               Boolean @default(true)
  isOnboarding           Boolean @default(false) // auto-enroll all new members
  publishOnPublicCatalog Boolean @default(false) // appears on the public /courses catalog when true

  // Categorization & access
  categoryId    String?
  requiredRoles Role[]    // when non-empty, only members with one listed role (or ADMIN) can self-enroll / see the course

  // ── Landing-page content (mirrors Program — RIM_Offering_Model.md) ────────
  heroImage       String? // background image URL for the /course/[slug] landing hero
  pullQuote       String? // floating quote card on the landing
  pullQuoteSource String? // attribution for the pull quote

  // ── Dana ──────────────────────────────────────────────────────────────────
  // Parallel to Program (session 123, slice 5). One mode per course; the
  // EnrollDanaButton + /api/courses/[slug]/checkout adapt their UI and
  // validation to the chosen mode. selfEnrollDanaRequired (above) stays
  // as a derived mirror — true whenever danaMode !== "none".
  //
  // Modes:
  //   "none"           — no dana step (free / onboarding / manual-grant courses)
  //   "voluntary"      — pay what you want; suggestedDana is the default
  //   "base_plus_dana" — minimum required (danaBaseAmount) + optional extra
  //   "fixed"          — exact amount (danaFixedAmount), no picker
  danaMode        String  @default("none")
  suggestedDana   Float?  // default for voluntary mode
  danaBaseAmount  Float?  // minimum for base_plus_dana mode
  danaFixedAmount Float?  // exact amount for fixed mode
  danaMessage     Json?   // RimTiptapEditor output (HTML string serialized to JSON) — rich-text dana explanation shown on the landing
  danaText        String? // free-form short note shown on the course landing page

  // Completion & presentation
  completionNote    String?  // shown when member completes the series
  discussionEnabled Boolean  @default(false)
  showDana          Boolean  @default(true)

  category    CourseCategory?    @relation(fields: [categoryId], references: [id])
  lessons     CourseLesson[]
  programs    ProgramCourse[]
  access      CourseAccess[]
  enrollments SeriesEnrollment[]

  @@index([slug])
  @@map("courses")
}

model Lesson {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titleInternal   String
  titleDisplayed  String
  slug            String   @unique

  accessLevel     CourseAccessLevel @default(ALL_MEMBERS)
  body            Json?    // BlockNote JSON

  heroImageUrl    String?  // Vercel Blob URL
  heroImageAlt    String?
  audioUrl        String?  // Vercel Blob URL
  videoUrl        String?  // YouTube or Vimeo URL

  headerQuote     String?
  quoteSource     String?

  resources       Json?    // { name, url, resourceType }[]

  // Learning system
  durationMinutes   Int?     // estimated reading/listening time shown on lesson cards
  reflectionPrompt  String?  // optional invitation shown at the bottom of the lesson

  courses   CourseLesson[]
  teachers  LessonTeacher[]
  progress  LessonProgress[]
  notes     LessonNote[]

  @@index([slug])
  @@map("lessons")
}

// One-to-one public profile for members flagged as teachers.
model TeacherProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  bio      String?
  photoUrl String?
  slug     String? @unique
  isPublic Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

// Many-to-many: Lesson ↔ User (member flagged as teacher)
model LessonTeacher {
  id       String @id @default(cuid())
  lessonId String
  userId   String
  order    Int    @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@map("lesson_teachers")
}

model ProgramTeacher {
  id        String @id @default(cuid())
  programId String
  userId    String
  order     Int    @default(0)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@map("program_teachers")
}

model CourseLesson {
  courseId   String
  lessonId   String
  sortOrder  Int     @default(0)
  groupLabel String? // Section header rendered before this lesson on the series page

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([courseId, lessonId])
  @@index([courseId, sortOrder])
  @@map("course_lessons")
}

model ProgramCourse {
  programId  String
  courseId   String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([programId, courseId])
  @@map("program_courses")
}

// ─── LEARNING SYSTEM ──────────────────────────────────────────────────────────
// Progress tracking, enrollment, and personal notes for the series/lesson library.

// Tracks which lessons a member has marked complete.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// Tracks conscious enrollment in a series (separate from access).
// Sets a start date and drives dashboard "Active Series" integration.
// completedAt is set when the member marks all lessons in the series complete.
model SeriesEnrollment {
  id               String           @id @default(cuid())
  userId           String
  courseId         String
  enrolledAt       DateTime         @default(now())
  completedAt      DateTime?
  enrollmentSource EnrollmentSource @default(SELF)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("series_enrollments")
}

// Personal notes a member writes while going through a lesson.
// Stored as BlockNote JSON (RimProseEditor).
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  body      Json?
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

// ─── DONATION MANAGEMENT (Phase 2) ───────────────────────────────────────────
// Unified log of all contributions regardless of source.
// Registration-linked Stripe donations are also captured here via webhook.

model Donation {
  id            String         @id @default(cuid())

  // Source tracking
  source        DonationSource
  amountCents   Int            // always stored in cents
  currency      String         @default("usd")
  donatedAt     DateTime

  // Donor info (optional — cash donations may be anonymous)
  userId        String?        // linked RIM member, if known
  donorName     String?
  donorEmail    String?

  // Program context (optional — not all donations are program-linked)
  programId     String?        // Sanity _id
  programTitle  String?

  // Course context (optional — for course self-enroll dana, session 123)
  courseId      String?
  courseTitle   String?

  // Registration link (for Stripe registration-flow donations)
  registrationId String?

  // Source-specific reference IDs
  stripePaymentIntentId   String?  @unique
  stripeCheckoutSessionId String?
  givebutterId            String?  // GiveButter transaction ID

  // Reconciliation
  notes         String?        // for cash/check: e.g. "envelope received 3/2"
  quickbooksRef String?        // QB transaction ID (future)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("donations")
}

enum DonationSource {
  STRIPE        // registration flow or direct link
  GIVEBUTTER    // imported from GiveButter
  CASH          // manually entered by treasurer
  CHECK         // manually entered by treasurer
  OTHER
}

// ─── HOST COMMUNITY HUB ──────────────────────────────────────────────────────
// Self-managed by HOST_MANAGER; independent of Registrar workflow.
// ⚠️ programSlug is the join key to Sanity — never change a slug after assignment.

// Who is responsible for hosting a specific program session.
// userId null = unclaimed session (seeded by HOST_MANAGER; open for anyone to claim).
// userId set + no open SubRequest = claimed.
// userId set + open SubRequest = sub needed.
// sessionDate null = "standing" (covers all occurrences; legacy concept — new sessions always have a date).
model HostAssignment {
  id          String    @id @default(cuid())
  programSlug String    // Sanity slug — treated as a stable, permanent identifier
  sessionDate DateTime? // null = standing; set = specific session date
  // Hub that owns this assignment (session 129 — auxiliary coverage).
  // Defaults to "host-team" — every row prior to the migration is the
  // primary hosting hub. After session 129, a single (programSlug,
  // sessionDate) may have multiple HostAssignment rows scoped to
  // different hubs: one host-team claim, one AV claim, N greeter claims.
  // Uniqueness within a hub is enforced app-layer; the database-level
  // unique (programSlug, sessionDate) was dropped to allow this.
  hubSlug     String    @default("host-team")
  userId      String?   // null = unclaimed session
  user        User?     @relation("HostAssignments", fields: [userId], references: [id], onDelete: SetNull)
  assignedBy  String?   // userId of HOST_MANAGER/ADMIN who created this
  notes       String?
  subRequests SubRequest[]

  // If set, this assignment was created by a standing rotation rule.
  // SetNull on parent delete preserves history (row stays, link breaks).
  // The "release future assignments" delete path explicitly cascades by app code.
  standingAssignmentId String?
  standingAssignment   StandingAssignment? @relation("StandingDerivedAssignments", fields: [standingAssignmentId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())

  @@index([programSlug, sessionDate, hubSlug])
  @@index([hubSlug, sessionDate])
  @@map("host_assignments")
}

// A host requesting coverage for one of their sessions.
model SubRequest {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   HostAssignment @relation(fields: [assignmentId], references: [id])
  programSlug  String         // denormalized for display without join
  sessionDate  DateTime?      // specific date (for recurring programs); null = next/all
  status       SubStatus      @default(OPEN)
  message      Json?          // context for potential claimers (BlockNote JSON)
  claim        SubClaim?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("sub_requests")
}

// A hub member volunteering to cover a sub request.
model SubClaim {
  id          String     @id @default(cuid())
  requestId   String     @unique
  request     SubRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  claimedById String
  claimedBy   User       @relation("SubClaims", fields: [claimedById], references: [id], onDelete: Cascade)
  message     Json?      // optional note to the original host (BlockNote JSON)
  createdAt   DateTime   @default(now())

  @@map("sub_claims")
}

enum SubStatus {
  OPEN
  CLAIMED
  CANCELLED
}

// ─── STANDING ASSIGNMENTS (host rotation patterns) ───────────────────────────
//
// A standing assignment says "User X hosts Program Y on occurrence Z of every
// month." When sessions are generated or applied, any session whose occurrence
// number matches a standing assignment (and whose date is within the active
// window) gets a HostAssignment created automatically.
//
// One host per slot: @@unique([programSlug, occurrence]) — updating a slot
// upserts the same record rather than creating duplicates.
//
// Occurrence meaning (within the month for this specific program):
//   FIRST  = 1st time this program runs in the month
//   SECOND = 2nd time, etc.
//   FIFTH  = 5th time — rare; for coordinators who want a specific 5th host
//   LAST   = last occurrence in the month (variable: 4th if 4 occurrences, 5th if 5)
//   ALL    = every occurrence (host covers the program every week it runs)

enum StandingOccurrence {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  LAST
  ALL
}

model StandingAssignment {
  id          String             @id @default(cuid())
  programSlug String
  /// Day-of-week scope for multi-day programs. "MO"|"TU"|"WE"|"TH"|"FR"|"SA"|"SU".
  /// Null for legacy rows or single-day programs where the day is implicit.
  /// New rotations created via the editor always set this.
  dayOfWeek   String?
  /// Hub that owns this rotation (session 129 — auxiliary coverage).
  /// Defaults to "host-team". A single program can have parallel rotations
  /// in different hubs: a host-team rotation on first-Saturday plus an AV
  /// rotation on the same first-Saturday is two records, scoped by hubSlug.
  /// Applied HostAssignments inherit this hubSlug.
  hubSlug     String             @default("host-team")
  userId      String
  occurrence  StandingOccurrence
  startsOn    DateTime           @default(now())
  endsOn      DateTime?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation("StandingAssignmentHost",    fields: [userId],      references: [id])
  createdBy   User               @relation("StandingAssignmentCreator", fields: [createdById], references: [id])

  // Reverse relation: HostAssignments derived from this rotation rule
  hostAssignments HostAssignment[] @relation("StandingDerivedAssignments")

  // Bundle = (programSlug, dayOfWeek, hubSlug). Inside a bundle, one record
  // per occurrence. The hubSlug element of the key lets parallel hubs hold
  // independent rotations on the same program/day/occurrence.
  @@unique([programSlug, dayOfWeek, occurrence, hubSlug])
  @@map("standing_assignments")
}

// HostThread and HostReply models removed in session 76 (hub conformance).
// Features (reactions, reply editing, categories) ported to shared HubConversationThread/Reply.
// Tables host_threads and host_replies retained in DB for historical reference.

// ─── MIGRATION FLAGS ─────────────────────────────────────────────────────────
// Tracker for the custom migrate.mjs runner. Prisma owns the table definition
// (so db push stops trying to drop it) but the migrate runner reads/writes it
// via raw SQL — never through Prisma client.

model MigrationFlag {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz

  @@map("_migration_flags")
}

model UserToolAccess {
  id          String   @id @default(cuid())
  userId      String
  toolSlug    String   // "learning", "programs", "inbox", "schedule"
  grantedAt   DateTime @default(now())
  grantedById String?

  user      User  @relation("ToolAccess", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("ToolAccessGranter", fields: [grantedById], references: [id])

  @@unique([userId, toolSlug])
  @@map("user_tool_access")
}

// ─── MULTI-HUB SYSTEM ────────────────────────────────────────────────────────
// Generic workspace system for any volunteer team. Each hub has tabs:
// Announcements (default), Documents, Conversations, Members, + optional Schedule.
// Access is driven by HubMember records, not by Role enum values.

enum HubType {
  OPERATIONAL
  GOVERNANCE
  COMMUNITY_GROUP
}

enum HubStatus {
  ACTIVE
  ARCHIVED
}


enum HubDocumentFileType {
  DOC
  SHEET
  SLIDE
  FORM
  LINK
  PDF
}

model Hub {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  name                   String
  type                   HubType
  description            String?
  status                 HubStatus     @default(ACTIVE)
  hasSchedule            Boolean       @default(false)
  welcomeHeadline        String?
  welcomeBody            Json?
  homeContent            Json?
  documentCategories     String[]      @default([])
  conversationCategories String[]      @default(["General"])
  // Hub-as-authority for programs (session 128 — Silent Meditation Hub).
  // When `assignmentGrantsTeacher` is true, an active HostAssignment for a
  // program whose `hostingHubSlug` matches this hub's slug confers teacher
  // capability on the assignee — Teacher pill, bell-friendly audio profile,
  // End-for-All fallback. Peer-led offerings (silent meditation, Recovery
  // Dharma) opt in; host-team stays at the default (false) since hosts on
  // operational programs are not teachers.
  // `teacherLabel` is the default pill text when this flag is true; the
  // pill hierarchy is `program.teacherLabel ?? hub.teacherLabel ?? "Teacher"`
  // (most specific wins).
  assignmentGrantsTeacher Boolean @default(false)
  teacherLabel           String?
  // Auxiliary-hub coverage model (session 129 — AV + Greeter hubs).
  // When `allowsMultipleAssignments` is true, the Scheduler treats this
  // hub as a multi-claimant sign-up surface (greeter hub): many users can
  // claim the same session, each producing one HostAssignment row. False
  // is the historical single-slot model (host-team, peer-led, AV): one
  // user per session per hub. Enforced app-layer in /api/host/assignments
  // since Prisma can't express partial uniques.
  allowsMultipleAssignments Boolean @default(false)
  // Program formats this hub schedules. Host-team and peer-led hubs cover
  // virtual+hybrid (their work is the live online session). AV and greeter
  // hubs cover in-person+hybrid (their work is the room). A hub whose
  // formats don't match a program will not surface that program in its
  // Scheduler view even if the program is otherwise tagged for coverage.
  // Default preserves existing behavior for host-team and peer-led.
  appliesToFormats       String[] @default(["virtual", "hybrid"])
  // Role-aware copy (session 130 follow-up — Maria + Jesse). Each hub
  // represents a functional role; UI copy and email subjects should speak
  // the role's language rather than the host-team default. Three fields:
  //   coverageNoun   — capitalized noun ("Host", "AV", "Greeter",
  //                    "Facilitator"). Used in labels like "{Noun} needed",
  //                    "{Noun}: [Name]", "Sign up as {Noun}".
  //   coverageVerb   — present-continuous verb phrase ("hosting", "covering
  //                    AV", "greeting", "facilitating"). Used in "You're
  //                    {verb}", "You're no longer {verb}", etc.
  //   coverageAction — base-form action phrase ("host this", "cover AV",
  //                    "greet", "facilitate"). Used in CTAs like "Yes, I
  //                    can {action}", "Sign up to {action}".
  // Defaults preserve host-team behavior so existing copy doesn't change
  // when a hub is missing values. Configured per-hub at /admin/hubs.
  coverageNoun           String   @default("Host")
  coverageVerb           String   @default("hosting")
  coverageAction         String   @default("host this")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  members       HubMember[]
  documents     HubDocument[]
  threads       HubConversationThread[]
  appLinks      HubAppLink[]

  @@map("hubs")
}

model HubAppLink {
  id        String  @id @default(cuid())
  hubId     String
  toolSlug  String?
  label     String
  href      String
  order     Int     @default(0)
  isEnabled Boolean @default(true)

  hub       Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@map("hub_app_links")
}


enum HubMemberStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

model HubMember {
  id            String    @id @default(cuid())
  hubId         String
  userId        String
  // Sync-owned: identity + role-derived
  position      String?   // e.g. "Virtual Host Coordinator" — free text label
  isCoordinator Boolean   @default(false)
  joinedAt      DateTime  @default(now())
  // Coordinator-owned: team state
  status                HubMemberStatus @default(ACTIVE)
  hostingCapability     Boolean         @default(true)  // For host-team: whether this member can receive LiveKit admin grants
  communicationsEnabled Boolean         @default(true)  // Whether this member gets hub notifications
  pausedAt              DateTime?
  pausedById            String?
  pauseNote             String?
  coordinatorNote       String?
  // Member-owned
  lastVisitedAt  DateTime? // for unread dot tracking on dashboard hub cards
  firstVisitedAt DateTime? // for newcomer welcome interstitial (Phase 2c)

  hub  Hub  @relation(fields: [hubId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hubId, userId])
  @@map("hub_members")
}

model HubDocument {
  id          String              @id @default(cuid())
  hubId       String
  addedById   String
  label       String
  url         String?             // nullable — native docs have no external URL
  description String?
  fileType    HubDocumentFileType @default(LINK)
  category    String?
  body        Json?               // BlockNote JSON — set when isNative = true
  isNative    Boolean             @default(false)
  isLocked    Boolean             @default(false) // Author can lock to prevent edits
  editingById String?             // Currently editing — presence tracking
  editingAt   DateTime?           // When the editor was last opened/heartbeat

  // Two-stage lifecycle.
  //   archivedAt = null + deletedAt = null → ACTIVE (shows in main list)
  //   archivedAt set, deletedAt = null    → ARCHIVED (read-only, "Archived" filter, visible to all members)
  //   deletedAt set                        → TRASHED (vanishes from members; visible only to ADMIN/GUIDING_TEACHER/coordinator at /trash)
  archivedAt   DateTime?
  archivedById String?
  deletedAt    DateTime?
  deletedById  String?

  hub           Hub      @relation(fields: [hubId], references: [id])
  addedBy       User     @relation("HubDocumentAuthor", fields: [addedById], references: [id], onDelete: Cascade)
  editingBy     User?    @relation("HubDocumentEditor", fields: [editingById], references: [id])
  archivedBy    User?    @relation("HubDocumentArchiver", fields: [archivedById], references: [id])
  deletedBy     User?    @relation("HubDocumentTrasher",  fields: [deletedById],  references: [id])
  notifications HubDocumentNotification[]
  conversations HubConversationThread[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hubId, deletedAt])
  @@map("hub_documents")
}

// One row per notification sent. No unique constraint on (documentId, userId) —
// the same person can be notified on creation and again on a later update.
// "Not yet notified" query: hub members whose userId is NOT IN
// (SELECT DISTINCT userId FROM hub_document_notifications WHERE documentId = X)
model HubDocumentNotification {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  notifiedAt DateTime @default(now())
  eventType  String   @default("created") // "created" | "updated"

  document HubDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, userId])
  @@map("hub_document_notifications")
}

model HubConversationThread {
  id                   String    @id @default(cuid())
  hubId                String
  authorId             String
  title                String
  body                 Json?
  category             String    @default("General")
  // status was the legacy archive marker (OPEN | CLOSED). Post-session-115 the
  // canonical archive marker is `archivedAt`; status is kept in sync by the
  // PATCH route for backward compatibility with clients that still read it.
  // Safe to remove in a future cleanup once nothing reads `status`.
  status               String    @default("OPEN")
  isPinned             Boolean   @default(false)
  pinnedAt             DateTime?
  edited               Boolean   @default(false)
  editedAt             DateTime?

  // Archive (separate from trash). When archivedAt is set, the thread is
  // hidden from the active conversations feed but readable in the Archived
  // view. Read-only when archived. Author or coordinator can toggle. Mirrors
  // HubDocument.archivedAt — both lifecycles now share the same shape.
  archivedAt           DateTime?
  archivedById         String?

  // Soft-delete (trash). When deletedAt is set, the thread vanishes from
  // members and is visible only to trash-managers at /account/hub/[slug]/trash.
  deletedAt            DateTime?
  deletedById          String?

  // When set, this thread belongs to a document rather than the hub conversations feed.
  documentId           String?

  hub           Hub               @relation(fields: [hubId], references: [id])
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  archivedBy    User?             @relation("HubThreadArchiver", fields: [archivedById], references: [id])
  deletedBy     User?             @relation("HubThreadTrasher", fields: [deletedById], references: [id])
  document      HubDocument?      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  replies       HubConversationReply[]
  subscriptions HubThreadSubscription[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([hubId, deletedAt])
  @@index([documentId])
  @@map("hub_conversation_threads")
}

/// Basecamp-style subscription: a member is "subscribed" to a thread and receives
/// every reply automatically. Source tracks how they got there so the UI can
/// explain it ("auto-subscribed as coordinator", "added by Mary", "self-subscribed").
/// Coordinators are auto-subscribed at thread creation; the author is always subscribed;
/// anyone the author/repliers pick via the "Also notify" panel is added with source=ADDED.
model HubThreadSubscription {
  id           String   @id @default(cuid())
  threadId     String
  userId       String
  subscribedAt DateTime @default(now())
  source       String   // AUTHOR | COORDINATOR_AUTO | ADDED | SELF

  thread HubConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([threadId])
  @@index([userId])
  @@map("hub_thread_subscriptions")
}

model HubConversationReply {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  body      Json?
  edited    Boolean   @default(false)
  editedAt  DateTime?
  reactions Json      @default("{}")

  thread    HubConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("hub_conversation_replies")
}

// ─── EMAIL TEMPLATE MANAGER ───────────────────────────────────────────────────
// Slugs are permanent system identifiers — never delete, never rename.
// Enabled = false means sendTemplatedEmail() silently no-ops for that slug.

model EmailTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  subject     String
  body        String   @db.Text
  // Optional plain-text fallback for better deliverability + accessibility.
  // If null, sendTemplatedEmail derives a text version from the markdown body.
  textBody    String?  @db.Text
  enabled     Boolean  @default(false)
  variables   String[]

  // Grouping for the admin list view
  group       String   @default("general")
  groupLabel  String   @default("General")
  // Minimum role required to view/edit this template (default: ADMIN)
  minRole     String   @default("ADMIN")

  // Help text displayed above the subject line in the editor
  helpText    String?
  // Callout for variables that originate in Sanity Studio (rendered distinctly)
  sanityNote  String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("email_templates")
}

// ─── LIVE SESSION CHAT ────────────────────────────────────────────────────────
//
// Persistent chat record for LiveKit session rooms. Sent live via LiveKit's
// data channel and POSTed here for history + DM filtering. New joiners fetch
// recent messages via GET to seed the chat sidebar.
//
// toIdentities empty = broadcast to room; non-empty = private DM (only sender
// and listed recipients see the message on read).

model SessionChatMessage {
  id            String   @id @default(cuid())
  roomName      String
  programSlug   String
  sessionDate   DateTime?
  fromUserId    String?
  fromIdentity  String
  fromName      String
  body          String
  toIdentities  String[] @default([])
  sentAt        DateTime @default(now())

  @@index([roomName, sentAt])
  @@map("session_chat_messages")
}

// ─── RATE LIMITING ────────────────────────────────────────────────────────────
//
// Postgres-backed counter for fixed-window rate limits. One row per
// (limit-key) — e.g. "signin-email:foo@bar.com" or "signin-ip:1.2.3.4".
// `count` increments on each call; when `expiresAt` passes, the next call
// resets the window. Cleanup cron deletes expired rows daily so the table
// stays small.
//
// Used by lib/rateLimit.ts to protect the NextAuth signin + callback
// endpoints from email-bombing and brute-force code-guessing.

model RateLimitWindow {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limit_windows")
}
