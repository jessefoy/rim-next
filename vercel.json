{
  "redirects": [
    {
      "source": "/account/hub/teacher",
      "destination": "/account/hub/courses",
      "permanent": true
    },
    {
      "source": "/account/hub/teacher/:path*",
      "destination": "/account/hub/courses/:path*",
      "permanent": true
    },
    {
      "source": "/account/hub/:slug/documents",
      "destination": "/account/hub/:slug/files",
      "permanent": true
    },
    {
      "source": "/account/hub/:slug/documents/:path*",
      "destination": "/account/hub/:slug/files",
      "permanent": true
    },
    {
      "source": "/account/documents",
      "destination": "/account/dashboard",
      "permanent": true
    },
    {
      "source": "/account/documents/:path*",
      "destination": "/account/dashboard",
      "permanent": true
    },
    {
      "source": "/volunteer/programs/:slug",
      "destination": "/tools/programs/:slug",
      "permanent": true
    },
    {
      "source": "/volunteer",
      "destination": "/tools/programs",
      "permanent": true
    },
    {
      "source": "/account/registrar/:slug",
      "destination": "/tools/programs/:slug",
      "permanent": true
    },
    {
      "source": "/account/registrar",
      "destination": "/tools/programs",
      "permanent": true
    },
    {
      "source": "/account/dashboard-my-registrations",
      "destination": "/account/programs",
      "permanent": true
    },
    {
      "source": "/account/dashboard-my-library",
      "destination": "/account/courses",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/cleanup-incomplete-accounts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/apply-standing-assignments",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-rate-limits",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/cleanup-pending-registrations",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/process-file-transfers",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/sweep-orphan-file-data",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/cron/archive-concluded-programs",
      "schedule": "15 9 * * *"
    }
  ]
}