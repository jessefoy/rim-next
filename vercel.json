{
  "redirects": [
    { "source": "/account/hub/teacher",        "destination": "/account/hub/courses",        "permanent": true },
    { "source": "/account/hub/teacher/:path*", "destination": "/account/hub/courses/:path*", "permanent": true },
    { "source": "/volunteer/programs/:slug", "destination": "/account/hub/registrar/programs/:slug", "permanent": true },
    { "source": "/volunteer", "destination": "/account/hub/registrar/programs", "permanent": true },
    { "source": "/account/registrar/:slug", "destination": "/account/hub/registrar/programs/:slug", "permanent": true },
    { "source": "/account/registrar", "destination": "/account/hub/registrar/programs", "permanent": true },
    { "source": "/account/dashboard-my-registrations", "destination": "/account/programs", "permanent": true },
    { "source": "/account/dashboard-my-library", "destination": "/account/courses", "permanent": true }
  ],
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/cleanup-incomplete-accounts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/seed-host-sessions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/missing-reports",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/drip-release",
      "schedule": "0 12 * * *"
    }
  ]
}
